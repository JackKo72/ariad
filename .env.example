# Pipeline mode: mock (default, no external API calls) | provider
ARIAD_MODE=mock

# Enable local-only synthetic-data debug artifact dumps (never in prod)
DEBUG_ARTIFACTS=false

# SQLite file path for the API (relative to apps/api)
ARIAD_DB_PATH=./data/ariad.db

# Base URL the web app uses to reach the API
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
