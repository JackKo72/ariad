# Pipeline mode: demo (default, no external API calls -- sample audio +
# MockLLMProvider only) | provider (real ASR/LLM, requires OPENAI_API_KEY)
ARIAD_MODE=demo

# Real provider config. Leave OPENAI_API_KEY empty to stay in demo mode --
# the app starts fine either way. Put the real value only in
# apps/api/.env.local (gitignored), never here, never in
# apps/web/.env.local (frontend bundles NEXT_PUBLIC_* into client JS, so
# provider keys must never live there).
OPENAI_API_KEY=
# Text LLM only (structure_transcript / patient_explanation). Any empty
# value falls back to gpt-4o-mini -- see app/dependencies.py.
OPENAI_TEXT_MODEL=

# ASR is a local model (sherpa-onnx: Whisper + pyannote + Silero VAD), not
# OpenAI -- see README.md "Phase D real providers" for the model download
# links. Directory layout expected under this path:
#   sherpa-onnx-whisper-large-v3/{large-v3-encoder.int8.onnx,large-v3-decoder.int8.onnx,large-v3-tokens.txt}
#   sherpa-onnx-pyannote-segmentation-3-0/model.onnx
#   emb.onnx
#   silero_vad.onnx
ARIAD_SHERPA_MODELS_DIR=./models

# Enable local-only synthetic-data debug artifact dumps (never in prod)
DEBUG_ARTIFACTS=false

# SQLite file path for the API (relative to apps/api)
ARIAD_DB_PATH=./data/ariad.db

# Local directory for uploaded/processed audio files (relative to apps/api).
# Never committed -- see .gitignore's `data/` rule.
ARIAD_AUDIO_DIR=./data/audio

# Base URL the web app uses to reach the API
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
